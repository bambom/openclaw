# OpenClaw Backup Git Ignore
# 多用户备份：每个用户使用自己的备份目录

# ==================== 敏感信息 ====================
# 认证文件（包含密钥和token）
identity/device-auth.json
credentials/*.json

# 配置文件（可能包含API密钥，可以备份但需注意）
openclaw.json
openclaw.json.bak*

# ==================== 依赖包 ====================
# npm依赖（可以通过npm install恢复）
**/node_modules/
**/node_modules/**
extensions/**/node_modules/

# ==================== 临时文件 ====================
# 锁定文件
**/*.lock
sessions/*.lock

# 日志文件
**/*.log

# 数据库文件
**/*.db
**/*.sqlite
**/*.sqlite3

# 临时文件
**/*.tmp
**/*.temp

# ==================== 缓存 ====================
# package-lock.json（可重新生成）
**/package-lock.json
**/yarn.lock

# ==================== 编译输出 ====================
# dist 目录
**/dist/
**/build/

# ==================== IDE配置 ====================
.vscode/
.idea/
*.swp
*.swo

# ==================== 操作系统 ====================
.DS_Store
Thumbs.db
desktop.ini

# ==================== 测试文件 ====================
**/.test/
**/tests/tmp/
